# Public endpoints consumed by the Next.js frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/dev
NEXT_PUBLIC_AWS_REGION=ap-northeast-1

# Amazon Cognito Hosted UI configuration
NEXT_PUBLIC_COGNITO_USER_POOL_ID=ap-northeast-1_example
NEXT_PUBLIC_COGNITO_CLIENT_ID=exampleclientid123
NEXT_PUBLIC_COGNITO_DOMAIN=example.auth.ap-northeast-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback
NEXT_PUBLIC_COGNITO_LOGOUT_URI=http://localhost:3000/
