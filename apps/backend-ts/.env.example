# AWS defaults for local SAM workflows
AWS_REGION=ap-northeast-1
STAGE_NAME=dev

# Database connectivity for Lambda handlers
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stamper
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
RDS_SECRET_ARN=arn:aws:secretsmanager:ap-northeast-1:123456789012:secret:stamper-rds-dev

# Cognito authorizer configuration
COGNITO_USER_POOL_ARN=arn:aws:cognito-idp:ap-northeast-1:123456789012:userpool/ap-northeast-1_example
COGNITO_USER_POOL_ID=ap-northeast-1_example
COGNITO_APP_CLIENT_ID=exampleclientid123
JWT_ISSUER=https://cognito-idp.ap-northeast-1.amazonaws.com/ap-northeast-1_example
JWT_AUDIENCE=exampleclientid123

# Storage and messaging resources
RECEIPTS_BUCKET=stamper-receipts-dev
OCR_QUEUE_URL=https://sqs.ap-northeast-1.amazonaws.com/123456789012/stamper-ocr-dev
