# AWS defaults for the OCR worker
AWS_REGION=ap-northeast-1
STAGE_NAME=dev

# Data sources
RECEIPTS_BUCKET=stamper-receipts-dev
OCR_QUEUE_URL=https://sqs.ap-northeast-1.amazonaws.com/123456789012/stamper-ocr-dev

# Database secret used to persist OCR results
RDS_SECRET_ARN=arn:aws:secretsmanager:ap-northeast-1:123456789012:secret:stamper-rds-dev

# Amazon Textract invocation parameters
TEXTRACT_FEATURE_TYPES=FORMS,TABLES
TEXTRACT_SNS_TOPIC_ARN=arn:aws:sns:ap-northeast-1:123456789012:stamper-textract-callback
